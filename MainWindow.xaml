<?xml version="1.0" encoding="utf-8" ?>
<winuiex:WindowEx
    x:Class="MagicCursor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MagicCursor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    Title="MagicCursor"
    IsTitleBarVisible="False"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="False"
    mc:Ignorable="d">
    
    <winuiex:WindowEx.SystemBackdrop>
        <winuiex:TransparentTintBackdrop TintColor="Transparent" />
    </winuiex:WindowEx.SystemBackdrop>

    <!-- Use a totally transparent background for the main grid -->
    <Grid Background="Transparent">
        <!-- The Frame hosts pages for your application content. -->
        <Frame x:Name="RootFrame" />
    </Grid>
</winuiex:WindowEx>
