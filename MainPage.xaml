<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MagicCursor.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MagicCursor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Animation to fade in and scale up the popup -->
        <Storyboard x:Name="ShowPopupAnimation">
            <DoubleAnimation Storyboard.TargetName="MagicMenu" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0" To="1" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="PopupScale" 
                             Storyboard.TargetProperty="ScaleX" 
                             From="0.9" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PopupScale" 
                             Storyboard.TargetProperty="ScaleY" 
                             From="0.9" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Animation to fade out the popup -->
        <Storyboard x:Name="HidePopupAnimation">
            <DoubleAnimation Storyboard.TargetName="MagicMenu" 
                             Storyboard.TargetProperty="Opacity" 
                             From="1" To="0" Duration="0:0:0.2" />
        </Storyboard>

        <!-- Scanning Animation (Rotation) -->
        <Storyboard x:Name="ScanningAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SelectionGradientTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.5" />
        </Storyboard>

        <!-- Processing Animation (Pulsing Glow) -->
        <Storyboard x:Name="ProcessingAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SelectionRectangle"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.4" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SelectionRectangle"
                             Storyboard.TargetProperty="StrokeThickness"
                             From="4" To="8" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Green Signal Pulse Animation -->
        <Storyboard x:Name="GreenSignalPulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AiLoadingIndicator"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- AI Loading Cursor Color Animation -->
        <Storyboard x:Name="AiLoadingCursorAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <ColorAnimation Storyboard.TargetName="CursorBrushStop1"
                            Storyboard.TargetProperty="Color"
                            To="#00FF66" Duration="0:0:0.6">
                <ColorAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
            <ColorAnimation Storyboard.TargetName="CursorBrushStop2"
                            Storyboard.TargetProperty="Color"
                            To="#008000" Duration="0:0:0.6">
                <ColorAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
            <ColorAnimation Storyboard.TargetName="SparkleBrushStop2"
                            Storyboard.TargetProperty="Color"
                            To="#00FF00" Duration="0:0:0.6">
                <ColorAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>
    </Page.Resources>

    <!-- Use a Grid as the absolute root to ensure the Modal stretches to cover the screen and intercepts clicks properly -->
    <Grid Background="Transparent">
        
        <!-- The Canvas now captures pointer events when the overlay is interactive -->
        <Canvas x:Name="RootCanvas" Background="#01000000" 
                PointerPressed="RootCanvas_PointerPressed"
                PointerReleased="RootCanvas_PointerReleased">
            
            <!-- The Magic Selection Highlight Box -->
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Canvas.ZIndex="5"
                       Fill="#2000BFFF"
                       StrokeThickness="4"
                       RadiusX="8" RadiusY="8">
                <Rectangle.Stroke>
                    <LinearGradientBrush x:Name="SelectionGradient" StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.Transform>
                            <RotateTransform x:Name="SelectionGradientTransform" Angle="0" CenterX="0.5" CenterY="0.5" />
                        </LinearGradientBrush.Transform>
                        <GradientStop Color="#00BFFF" Offset="0.0" /> <!-- Deep Sky Blue -->
                        <GradientStop Color="#FF00FF" Offset="0.33" /> <!-- Magenta -->
                        <GradientStop Color="#7B68EE" Offset="0.66" /> <!-- Medium Slate Blue -->
                        <GradientStop Color="#00BFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
            </Rectangle>

            <!-- Canvas for the dynamically generated falling particles -->
            <Canvas x:Name="ParticleCanvas" Canvas.Left="0" Canvas.Top="0" IsHitTestVisible="False" Canvas.ZIndex="10"/>

            <!-- The Dynamic Context Menu -->
            <Border x:Name="MagicMenu" 
                    Canvas.ZIndex="20"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Background="#EA0A0A12"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="10"
                    Width="220"
                    RenderTransformOrigin="0,0">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00BFFF" Offset="0.0" />
                        <GradientStop Color="#FF00FF" Offset="0.5" />
                        <GradientStop Color="#7B68EE" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PopupScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>

                <StackPanel Orientation="Vertical">
                    <!-- Header -->
                    <Grid Margin="8,4,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="✨ Gemini Actions" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="#B0FFFFFF"
                                   VerticalAlignment="Center"/>

                        <!-- Green signal indicator -->
                        <StackPanel x:Name="AiLoadingIndicator" 
                                    Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    Spacing="6" 
                                    Visibility="Collapsed" 
                                    VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#00FF66" VerticalAlignment="Center"/>
                            <TextBlock Text="AI Active" FontSize="11" Foreground="#00FF66" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <MenuFlyoutSeparator Margin="0,0,0,6"/>

                    <!-- Custom Query Input -->
                    <Border Background="#20FFFFFF" CornerRadius="8" Padding="4,2" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#30FFFFFF">
                        <Grid>
                            <local:MagicTextBox x:Name="CustomQueryInput" 
                                     PlaceholderText="Ask anything..." 
                                     FontSize="12" 
                                     Background="Transparent" 
                                     BorderThickness="0"
                                     AcceptsReturn="False"
                                     Foreground="White"
                                     PlaceholderForeground="#80FFFFFF"
                                     KeyDown="CustomQueryInput_KeyDown"/>
                        </Grid>
                    </Border>

                    <!-- Feature 1 -->
                    <Button Click="AnalyzeButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8D2;" FontSize="16" Margin="0,0,12,0" Foreground="#00BFFF"/>
                            <TextBlock Text="Analyze Selection" FontSize="13" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Feature 2 -->
                    <Button Click="SummarizeButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE71F;" FontSize="16" Margin="0,0,12,0" Foreground="#7B68EE"/>
                            <TextBlock Text="Summarize" FontSize="13" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <MenuFlyoutSeparator Margin="0,4,0,4"/>

                    <!-- Settings -->
                    <Button Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Margin="0,0,12,0" Foreground="#FF8C00"/>
                            <TextBlock Text="API Key Settings" FontSize="13" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- The Custom Magic Cursor Visual (Premium Blue, Scaled Down) -->
            <Grid x:Name="CustomCursor" 
                  Canvas.ZIndex="100"
                  Opacity="0"
                  Canvas.Left="0" Canvas.Top="0"
                  IsHitTestVisible="False">
                
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                </Grid.RenderTransform>

                <!-- The main cursor pointer -->
                <Path Data="M 0,0 L 0,21 L 4.5,17 L 8,24 L 10.5,22.5 L 7,15.5 L 15,15.5 Z" 
                      Stroke="White" 
                      StrokeThickness="1.5"
                      StrokeLineJoin="Round">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="CursorBrushStop1" Color="#00BFFF" Offset="0.0" />
                            <GradientStop x:Name="CursorBrushStop2" Color="#0033CC" Offset="1.0" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                      
                <!-- The attached sparkle on the right side -->
                <Path Data="M 5,0 L 6,3 L 9,4 L 6,5 L 5,8 L 4,5 L 1,4 L 4,3 Z" 
                      Margin="14,10,0,0">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="SparkleBrushStop1" Color="#FFFFFF" Offset="0.0" />
                            <GradientStop x:Name="SparkleBrushStop2" Color="#40E0D0" Offset="1.0" />
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
            
        </Canvas>
        <Grid x:Name="ResponseModal" 
              Visibility="Collapsed" 
              Background="#B3080810">
            
            <Border BorderThickness="2"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="600"
                    MaxHeight="600"
                    Padding="28"
                    Background="#EC10101A">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00BFFF" Offset="0.0" />
                        <GradientStop Color="#FF00FF" Offset="0.5" />
                        <GradientStop Color="#7B68EE" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
 
                    <!-- Modal Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <FontIcon Glyph="&#xE8D2;" FontSize="20" Foreground="#00BFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Gemini Insight" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
 
                    <!-- Response Content -->
                    <ScrollViewer Grid.Row="1" Margin="0,0,0,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResponseContentPanel" Spacing="0"/>
                    </ScrollViewer>
 
                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Click="CopyButton_Click" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#33FFFFFF" Foreground="White" Padding="16,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="#FF00FF"/>
                                <TextBlock Text="Copy" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Click="CloseModalButton_Click" Foreground="White" BorderThickness="0" Padding="16,8" CornerRadius="6">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00BFFF" Offset="0.0" />
                                    <GradientStop Color="#7B68EE" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="Close" FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Full Screen Settings Modal -->
        <Grid x:Name="SettingsModal" 
              Visibility="Collapsed" 
              Background="#B3080810">
            
            <Border BorderThickness="2"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    Padding="28"
                    Background="#EC10101A">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF8C00" Offset="0.0" />
                        <GradientStop Color="#FF00FF" Offset="0.5" />
                        <GradientStop Color="#7B68EE" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
 
                    <!-- Modal Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="#FF8C00" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Magic Cursor Settings" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
 
                    <!-- Description & Key Link -->
                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,20">
                        <TextBlock Text="A Google Gemini API key is required to use Magic Cursor. This key will be saved locally on your computer." 
                                   FontSize="13" Foreground="#CCCCCC" TextWrapping="Wrap" LineHeight="18"/>
                        <HyperlinkButton Content="Get a Gemini API Key from Google AI Studio ↗" 
                                         NavigateUri="https://aistudio.google.com/api-keys"
                                         FontSize="13" Foreground="#00BFFF" Padding="0,2,0,2"/>
                    </StackPanel>

                    <!-- API Key PasswordBox Input -->
                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,20">
                        <TextBlock Text="Gemini API Key:" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <Border Background="#20FFFFFF" CornerRadius="8" Padding="6,4" BorderThickness="1" BorderBrush="#30FFFFFF">
                            <PasswordBox x:Name="SettingsApiKeyInput" 
                                         PlaceholderText="AIzaSy..." 
                                         FontSize="13" 
                                         Background="Transparent" 
                                         BorderThickness="0"
                                         Foreground="White"
                                         PasswordChar="●"
                                         IsPasswordRevealButtonEnabled="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Startup Option -->
                    <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,20">
                        <CheckBox x:Name="StartupCheckBox" 
                                  Content="Run Magic Cursor at Windows startup" 
                                  FontSize="13" 
                                  Foreground="White"/>
                    </StackPanel>

                    <!-- Status Display -->
                    <TextBlock x:Name="SettingsStatusText" 
                               Grid.Row="4" 
                               Text="" 
                               FontSize="12" 
                               Foreground="#FF4500" 
                               Margin="0,0,0,20" 
                               Visibility="Collapsed" 
                               TextWrapping="Wrap"/>
 
                    <!-- Footer Buttons -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="CancelSettingsButton" Grid.Column="0" Click="CancelSettingsButton_Click" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#33FFFFFF" Foreground="White" Padding="16,8" CornerRadius="6" HorizontalAlignment="Left">
                            <TextBlock x:Name="CancelSettingsButtonText" Text="Cancel" Foreground="White"/>
                        </Button>
                        
                        <Button Grid.Column="1" Click="SaveSettingsButton_Click" Foreground="White" BorderThickness="0" Padding="20,8" CornerRadius="6" HorizontalAlignment="Right">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF8C00" Offset="0.0" />
                                    <GradientStop Color="#FF00FF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="Save Settings" FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
